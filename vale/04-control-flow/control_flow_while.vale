import stdlib.*;

exported func main() {
  // Count from 1 up to 5
  i = 1;
  while i <= 5 {
    println("Count: " + i);
    set i = i + 1;
  }

  // Accumulate a running total of 1 through 10
  total = 0;
  n = 1;
  while n <= 10 {
    set total = total + n;
    set n = n + 1;
  }
  println("Sum of 1..10 is: " + total);
}
