procedure main()
    # while: repeats while the condition succeeds
    i := 1
    while i <= 5 do {
        writes(i, " ")
        i +:= 1
    }
    write()

    # every: iterate over all values of the generator 1 to 5
    every j := 1 to 5 do
        writes(j * j, " ")
    write()

    # repeat: an infinite loop exited with break
    k := 0
    repeat {
        k +:= 1
        if k > 3 then break
        writes(k, " ")
    }
    write()
end
