a = 17
b = 5

puts "a + b  = #{a + b}"
puts "a - b  = #{a - b}"
puts "a * b  = #{a * b}"
puts "a / b  = #{a / b}"      # Float division -> Float64
puts "a // b = #{a // b}"     # Integer (floor) division
puts "a % b  = #{a % b}"      # Modulo
puts "a ** b = #{a ** b}"     # Exponentiation
puts "-a     = #{-a}"         # Unary minus
